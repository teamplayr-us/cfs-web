# Athlete registration — set these in Vercel (Project → Settings →
# Environment Variables). Checkout stays disabled (friendly 503) until the
# Stripe vars exist; the webhook refuses everything until both Stripe vars
# exist; Airtable writes fail-and-retry until the Airtable vars exist.

# Stripe (use test keys until launch)
STRIPE_SECRET_KEY=sk_test_xxx
# From the Stripe dashboard webhook endpoint pointing at
# https://www.collegeflagshowcase.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Airtable (personal access token with data.records:read + write on the base)
AIRTABLE_API_KEY=pat_xxx
# "College Flag Showcase" base
AIRTABLE_BASE_ID=app0mk0cTZLDeVahe
# "Athlete Registrations" table — use the table ID, not the name, so renames
# in the Airtable UI can't break the webhook
AIRTABLE_TABLE=tblmp5EHSrHHaxjpD

# "Team Invite Requests" table (defaults to the created table's ID in code;
# set only to override)
# AIRTABLE_TEAM_TABLE=tblqtHoZgqgkNTgle

# "Sponsor Interest" table (defaults to the created table's ID in code;
# set only to override)
# AIRTABLE_SPONSOR_TABLE=tblW8wpENPt3yQDB0

# "Coach Registrations" table (defaults to the created table's ID in code;
# set only to override)
# AIRTABLE_COACH_TABLE=tblCZuBfVMjkEo5c5

# MailerSend — transactional email (notifications + confirmations).
# Emails silently no-op until this is set.
MAILERSEND_API_TOKEN=mlsn_xxx

# Tournament-team athlete discount: the code shared with invited teams'
# coaches. Case-insensitive match; $50 off the Combine & Camp price.
# Until this is set, any code entered at checkout is rejected.
TOURNAMENT_DISCOUNT_CODE=xxx
